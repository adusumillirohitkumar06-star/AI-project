# Build / Runtime Configuration for AI Airport Operations & Gate Allocation Simulator

# ==========================================
# BACKEND (FastAPI + SQLAlchemy + Uvicorn)
# ==========================================
PROJECT_NAME="AI Airport Operations & Gate Allocation Simulator"
VERSION="0.1.0"
ENVIRONMENT="production"
DEBUG="false"

# Production PostgreSQL Database URL
# Example: postgresql://user:password@db.service.region.internal:5432/airport_db
DATABASE_URL="postgresql://postgres:YOUR_STRONG_PASSWORD@localhost:5432/airport_pbl"

# Connection Pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Authentication & Security
# Generate via: openssl rand -hex 32
SECRET_KEY="replace-this-with-a-cryptographically-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production Hardening
ENABLE_SECURITY_HEADERS="true"
RATE_LIMIT_LOGIN_PER_MINUTE=60

# Allowed CORS Origins (JSON list of frontend production URLs)
# Example: ["https://airport-control.vercel.app"]
CORS_ORIGINS=["https://airport-control.vercel.app","http://localhost:3000"]

# Port to bind (auto-injected by Render, Railway, Fly.io or default 8000)
PORT=8000

# ==========================================
# FRONTEND (Next.js 16)
# ==========================================
# Public API base endpoint (Accessible by client browser)
# Example: https://ai-airport-backend.onrender.com
NEXT_PUBLIC_API_URL="https://ai-airport-backend.onrender.com"
